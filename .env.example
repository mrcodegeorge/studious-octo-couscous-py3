# NETSENTRY Configuration
APP_NAME=NETSENTRY
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/netsentry.db

# Network Monitoring
# Leave blank for auto-detection of default interface and subnet
NETWORK_INTERFACE=
AUTHORIZED_SUBNET=
SCAN_INTERVAL=10

# Camera Session Limits
CAMERA_SESSION_MAX_MINUTES=10
CAMERA_FRAME_RATE=15

# Security & Lockout
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
REGISTRATION_CODE_EXPIRE_MINUTES=15

# Demo Mode (Simulate network activity and camera for evaluation/testing)
DEMO_MODE=False
